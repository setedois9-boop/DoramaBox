{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/:file(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"DoramaBox (1).apk\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/painel",
      "destination": "/painel.html"
    }
  ],
  "redirects": [
    {
      "source": "/download",
      "destination": "/doramabox.apk"
    },
    {
      "source": "/admin",
      "destination": "/painel"
    }
  ]
}
