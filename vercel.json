{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/download",
      "dest": "/download.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/termos",
      "dest": "/termos.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
